{
  "manifest_version": 3,
  "name": "Gemini Vids Button",
  "description": "Adds a 'Vids' button to the left sidebar of gemini.google.com",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
